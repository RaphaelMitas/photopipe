<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Contents/MacOS/photopipe-core. Exactly two keys: anything else and the sidecar
  stops inheriting the parent's file access and starts asking for its own, which
  it cannot get. exiftool needs none of its own — a grandchild inherits too.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.inherit</key>
	<true/>
</dict>
</plist>
