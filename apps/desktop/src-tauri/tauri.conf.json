{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Photopipe",
  "version": "0.4.5",
  "identifier": "net.photopipe.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "../../scripts/prepare-bundle.sh && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Photopipe",
        "width": 1100,
        "height": 720
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/Library/Caches/Photopipe/**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM0RDEzODVEMkE2REEwRDAKUldUUW9HMHFYVGpSeEdjMGVpVFVyR21PVWlJT0N2TTBpWmM2aFJQOEVtNHVzKzRyNCtNam5LQ2MK",
      "endpoints": [
        "https://github.com/RaphaelMitas/photopipe/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/photopipe-core"],
    "macOS": {
      "minimumSystemVersion": "15.0"
    },
    "resources": {
      "resources/exiftool": "exiftool"
    }
  }
}
