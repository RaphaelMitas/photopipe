{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Photopipe",
  "version": "0.1.0",
  "identifier": "com.photopipe.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "../../scripts/fetch-exiftool.sh && ../../scripts/build-core.sh release && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Photopipe",
        "width": 1100,
        "height": 720
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/Library/Caches/Photopipe/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/photopipe-core"],
    "macOS": {
      "minimumSystemVersion": "15.0"
    },
    "resources": {
      "resources/exiftool": "exiftool"
    }
  }
}
