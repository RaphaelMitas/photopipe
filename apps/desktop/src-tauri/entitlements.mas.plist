<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The App Store build. `user-selected.read-write` is the open panel's grant and
  `bookmarks.app-scope` is what keeps it across launches; the core inherits both
  through entitlements.mas.inherit.plist. No temporary-exception keys: the spike
  proved none are needed, and each one is a question at review.

  `network.client` is not optional and not about the network. Without it a
  sandboxed WKWebView never loads the page at all — not even tauri://localhost,
  which is served from inside the app. Photopipe itself calls nothing out; the
  updater, its only network code, is compiled out of this build.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
</dict>
</plist>
