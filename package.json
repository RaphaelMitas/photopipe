{
  "name": "photopipe",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "./scripts/fetch-exiftool.sh && pnpm --filter desktop tauri dev",
    "check": "biome check .",
    "typecheck": "pnpm -r typecheck",
    "check:fix": "biome check --write .",
    "release": "node scripts/release.mjs",
    "screenshots": "pnpm --filter desktop screenshots"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4"
  }
}
