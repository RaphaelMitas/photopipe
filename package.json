{
  "name": "photopipe",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "./scripts/prepare-bundle.sh && pnpm --filter desktop tauri dev",
    "check": "biome check .",
    "typecheck": "pnpm -r typecheck",
    "check:fix": "biome check --write .",
    "release": "node scripts/release.mjs",
    "screenshots": "pnpm --filter desktop screenshots"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7"
  }
}
