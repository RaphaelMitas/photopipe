{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommits",
    ":dependencyDashboard"
  ],
  "timezone": "Europe/Berlin",
  "schedule": ["before 7am on monday"],
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 5,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 7am on the first day of the month"]
  },
  "packageRules": [
    {
      "groupName": "non-major dependencies",
      "groupSlug": "non-major",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "matchPackageNames": ["*"],
      "description": "Everything non-breaking lands in a single weekly PR"
    },
    {
      "groupName": null,
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "description": "One PR per major, each waiting for manual approval from the dashboard"
    },
    {
      "groupName": "Tauri major",
      "matchUpdateTypes": ["major"],
      "matchPackageNames": ["/tauri/"],
      "dependencyDashboardApproval": true,
      "description": "tauri, @tauri-apps/*, tauri-build, tauri-plugin-* move in lockstep across npm and cargo, so their majors stay together"
    }
  ]
}
