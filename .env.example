# Absolute or relative path to the camera directory (the shoot folders live here).
# Inside Docker this is /data/camera.
CAMERA_BASE=./test-data/Camera

# Host-side path shown in the PureRAW instructions card (display only).
CAMERA_HOST_BASE=~/pictures/Camera

# Where the SQLite index lives. It is a disposable cache of what is on disk —
# delete it and the app rebuilds it on next boot.
PHOTOPIPE_DB=./data/index.db
